:50%;transform:translateX(-50%);width:100%;max-width:520px;z-index:60;display:flex;align-items:center;justify-content:space-between;padding:14px 20px;background:linear-gradient(180deg,rgba(239,235,226,.94),rgba(239,235,226,0));backdrop-filter:blur(6px)\">\n<span style=\"font:500 11px/1 'DM Sans',sans-serif;letter-spacing:.22em;text-transform:uppercase;color:#1E3A2B\">The Plate Method<\u002Fspan>\n<a href=\"#day\" style=\"font:500 10px/1 'DM Sans',sans-serif;letter-spacing:.16em;text-transform:uppercase;color:#FBF9F5;background:#1E3A2B;padding:9px 14px;border-radius:100px\">Start today<\u002Fa>\n<\u002Fheader>\n\n<section id=\"top\" style=\"position:relative;min-height:100svh;display:flex;flex-direction:column;justify-content:flex-end;padding:64px 22px 46px;overflow:hidden\">\n  <div data-px=\"26\" style=\"position:absolute;top:-4%;left:-18%;width:136%;height:70%;background:url(&quot;f75f3c28-5c01-4ac9-8528-a90f9cae62a9&quot;) center/cover;opacity:.85\"><\u002Fdiv>\n  <div style=\"position:absolute;inset:0;background:linear-gradient(180deg,rgba(239,235,226,.35) 0%,rgba(239,235,226,.1) 30%,rgba(239,235,226,.9) 62%,#EFEBE2 78%)\"><\u002Fdiv>\n\n  <div data-px=\"-30\" data-px-rot=\"9\" style=\"position:relative;flex:none;width:min(78%,38svh);aspect-ratio:1;margin:0 auto 26px;border-radius:50%;overflow:hidden;box-shadow:0 40px 90px -30px rgba(30,58,43,.55),0 0 0 1px rgba(255,255,255,.5)\">\n    <img src=\"c23b267e-2d19-4df8-8ff6-7f9761cfcdbe\" alt=\"A balanced plate\" style=\"width:100%;height:100%;object-fit:cover;display:block;transform:scale(1.1)\">\n  <\u002Fdiv>\n\n  <div style=\"position:relative\">\n    <div data-reveal=\"\" style=\"display:flex;align-items:center;gap:10px;margin-bottom:16px\">\n      <span style=\"width:26px;height:1px;background:#5C7A46\"><\u002Fspan>\n      <span style=\"font:500 10px/1 'DM Sans',sans-serif;letter-spacing:.24em;text-transform:uppercase;color:#5C7A46\">No counting. No cutting out.<\u002Fspan>\n    <\u002Fdiv>\n    <h1 data-reveal=\"\" data-delay=\"90\" style=\"margin:0;font:400 clamp(52px,15.5vw,78px)/0.93 'Instrument Serif',Georgia,serif;letter-spacing:-.02em;color:#1E3A2B\">Build the<br>plate.<br><em style=\"color:#5C7A46\">The rest<br>follows.<\u002Fem><\u002Fh1>\n    <p data-reveal=\"\" data-delay=\"180\" style=\"margin:22px 0 0;max-width:330px;font:300 16.5px/1.62 'DM Sans',sans-serif;color:rgba(30,58,43,.72)\">Half vegetables. A quarter protein. A quarter smart carbs. One rule, repeated three times a day, is what makes weight loss hold.<\u002Fp>\n    <div data-reveal=\"\" data-delay=\"260\" style=\"display:flex;gap:10px;margin-top:26px\">\n      <a href=\"#method\" style=\"flex:1;text-align:center;padding:16px;border-radius:100px;background:#1E3A2B;color:#FBF9F5;font:500 12px/1 'DM Sans',sans-serif;letter-spacing:.14em;text-transform:uppercase\">See the method<\u002Fa>\n      <a href=\"#shop\" style=\"padding:16px 20px;border-radius:100px;border:1px solid rgba(30,58,43,.22);color:#1E3A2B;font:500 12px/1 'DM Sans',sans-serif;letter-spacing:.14em;text-transform:uppercase\">Shop list<\u002Fa>\n    <\u002Fdiv>\n  <\u002Fdiv>\n  <div style=\"position:absolute;bottom:14px;left:50%;transform:translateX(-50%);width:1px;height:26px;background:linear-gradient(180deg,transparent,#5C7A46);animation:cue 2.6s ease-in-out infinite\"><\u002Fdiv>\n<\u002Fsection>\n\n<section style=\"padding:12px 22px 56px;display:grid;grid-template-columns:repeat(4,1fr);gap:8px;border-top:1px solid rgba(30,58,43,.1)\">\n  <sc-for list=\"{{ pillars }}\" as=\"p\" hint-placeholder-count=\"4\">\n    <div data-reveal=\"\" style=\"text-align:center\">\n      <div style=\"font:400 26px/1 'Instrument Serif',Georgia,serif;color:#5C7A46;padding:18px 0 8px\">{{ p.n }}<\u002Fdiv>\n      <div style=\"font:500 9.5px/1.35 'DM Sans',sans-serif;letter-spacing:.1em;text-transform:uppercase;color:rgba(30,58,43,.6)\">{{ p.t }}<\u002Fdiv>\n    <\u002Fdiv>\n  <\u002Fsc-for>\n<\u002Fsection>\n\n<section id=\"method\" style=\"position:relative;padding:64px 22px 72px;background:#1E3A2B;color:#F2EFE7;overflow:hidden\">\n  <div data-px=\"18\" style=\"position:absolute;top:-70px;right:-90px;width:280px;height:280px;border-radius:50%;border:1px solid rgba(242,239,231,.14)\"><\u002Fdiv>\n  <div data-px=\"30\" style=\"position:absolute;bottom:-120px;left:-110px;width:320px;height:320px;border-radius:50%;border:1px solid rgba(242,239,231,.1)\"><\u002Fdiv>\n\n  <div data-reveal=\"\" style=\"font:500 10px/1 'DM Sans',sans-serif;letter-spacing:.24em;text-transform:uppercase;color:#9CB587\">01 — The Method<\u002Fdiv>\n  <h2 data-reveal=\"\" data-delay=\"80\" style=\"margin:14px 0 0;font:400 42px/1.02 'Instrument Serif',Georgia,serif;letter-spacing:-.015em\">One plate,<br>three portions.<\u002Fh2>\n  <p data-reveal=\"\" data-delay=\"140\" style=\"margin:16px 0 30px;font:300 15.5px/1.62 'DM Sans',sans-serif;color:rgba(242,239,231,.66);max-width:340px\">Tap a portion to see what belongs there and why it earns the space.<\u002Fp>\n\n  <div style=\"position:relative;width:100%;aspect-ratio:1;border-radius:50%;overflow:hidden;margin-bottom:26px;box-shadow:0 30px 70px -28px rgba(0,0,0,.7)\">\n    <img src=\"c23b267e-2d19-4df8-8ff6-7f9761cfcdbe\" alt=\"Balanced plate portions\" style=\"width:100%;height:100%;object-fit:cover;display:block;transform:scale(1.1)\">\n    <div style=\"position:absolute;inset:0\">{{ plateOverlay }}<\u002Fdiv>\n  <\u002Fdiv>\n\n  <div style=\"display:flex;flex-direction:column;gap:10px\">\n    <sc-for list=\"{{ portions }}\" as=\"pt\" hint-placeholder-count=\"3\">\n      <button sc-camel-on-click=\"{{ pt.select }}\" style=\"{{ pt.cardStyle }}\">\n        <div style=\"display:flex;align-items:center;gap:14px\">\n          <span style=\"font:400 30px/1 'Instrument Serif',Georgia,serif;min-width:44px;color:{{ pt.hue }}\">{{ pt.frac }}<\u002Fspan>\n          <div style=\"flex:1;text-align:left\">\n            <div style=\"font:500 11px/1 'DM Sans',sans-serif;letter-spacing:.16em;text-transform:uppercase\">{{ pt.name }}<\u002Fdiv>\n            <div style=\"font:300 13px/1.5 'DM Sans',sans-serif;color:rgba(242,239,231,.55);margin-top:5px\">{{ pt.short }}<\u002Fdiv>\n          <\u002Fdiv>\n          <span style=\"{{ pt.chev }}\">+<\u002Fspan>\n        <\u002Fdiv>\n        <div style=\"{{ pt.bodyStyle }}\">\n          <p style=\"margin:14px 0 10px;font:300 14px/1.65 'DM Sans',sans-serif;color:rgba(242,239,231,.8);text-align:left\">{{ pt.body }}<\u002Fp>\n          <div style=\"display:flex;flex-wrap:wrap;gap:6px\">\n            <sc-for list=\"{{ pt.examples }}\" as=\"ex\" hint-placeholder-count=\"4\">\n              <span style=\"font:400 11.5px/1 'DM Sans',sans-serif;padding:7px 11px;border-radius:100px;background:rgba(242,239,231,.09);color:rgba(242,239,231,.8)\">{{ ex }}<\u002Fspan>\n            <\u002Fsc-for>\n          <\u002Fdiv>\n        <\u002Fdiv>\n      <\u002Fbutton>\n    <\u002Fsc-for>\n  <\u002Fdiv>\n\n  <div data-reveal=\"\" style=\"margin-top:22px;display:flex;gap:14px;align-items:flex-start;padding:18px;border-radius:16px;background:rgba(242,239,231,.07)\">\n    <span style=\"font:400 26px/1 'Instrument Serif',Georgia,serif;color:#9CB587\">＋<\u002Fspan>\n    <div>\n      <div style=\"font:500 11px/1 'DM Sans',sans-serif;letter-spacing:.16em;text-transform:uppercase;color:#F2EFE7\">Water, always<\u002Fdiv>\n      <p style=\"margin:8px 0 0;font:300 13.5px/1.6 'DM Sans',sans-serif;color:rgba(242,239,231,.62)\">A glass before each meal. Thirst reads as hunger more often than you would guess, and hydration keeps digestion and energy steady.<\u002Fp>\n    <\u002Fdiv>\n  <\u002Fdiv>\n<\u002Fsection>\n\n<section id=\"why\" style=\"position:relative;padding:64px 22px 70px;overflow:hidden\">\n  <div data-px=\"22\" style=\"position:absolute;top:6%;right:-30%;width:70%;aspect-ratio:1;border-radius:50%;background:radial-gradient(circle at 40% 40%,rgba(92,122,70,.16),transparent 68%)\"><\u002Fdiv>\n  <div data-reveal=\"\" style=\"font:500 10px/1 'DM Sans',sans-serif;letter-spacing:.24em;text-transform:uppercase;color:#5C7A46\">02 — Why it works<\u002Fdiv>\n  <h2 data-reveal=\"\" data-delay=\"80\" style=\"margin:14px 0 28px;font:400 42px/1.02 'Instrument Serif',Georgia,serif;letter-spacing:-.015em;color:#1E3A2B\">Nothing here<br>is a trick.<\u002Fh2>\n\n  <div style=\"display:flex;flex-direction:column;gap:9px;position:relative\">\n    <sc-for list=\"{{ reasons }}\" as=\"r\" hint-placeholder-count=\"4\">\n      <button sc-camel-on-click=\"{{ r.toggle }}\" style=\"{{ r.style }}\">\n        <div style=\"display:flex;align-items:baseline;gap:12px\">\n          <span style=\"font:500 10px/1 'DM Sans',sans-serif;letter-spacing:.1em;color:rgba(30,58,43,.35)\">{{ r.num }}<\u002Fspan>\n          <span style=\"flex:1;text-align:left;font:400 21px/1.25 'Instrument Serif',Georgia,serif;color:#1E3A2B\">{{ r.title }}<\u002Fspan>\n          <span style=\"{{ r.mark }}\">↓<\u002Fspan>\n        <\u002Fdiv>\n        <div style=\"{{ r.bodyStyle }}\">\n          <p style=\"margin:12px 0 0;text-align:left;font:300 14.5px/1.7 'DM Sans',sans-serif;color:rgba(30,58,43,.7)\">{{ r.body }}<\u002Fp>\n          <div style=\"margin-top:12px;padding-left:13px;border-left:2px solid #B8892B;text-align:left\">\n            <div style=\"font:500 9.5px/1 'DM Sans',sans-serif;letter-spacing:.18em;text-transform:uppercase;color:#B8892B\">{{ r.term }}<\u002Fdiv>\n            <div style=\"margin-top:6px;font:400 13px/1.6 'DM Sans',sans-serif;color:rgba(30,58,43,.62);font-style:italic\">{{ r.def }}<\u002Fdiv>\n          <\u002Fdiv>\n        <\u002Fdiv>\n      <\u002Fbutton>\n    <\u002Fsc-for>\n  <\u002Fdiv>\n<\u002Fsection>\n\n<section id=\"day\" style=\"position:relative;padding:60px 0 70px;background:#FBF9F5;border-top:1px solid rgba(30,58,43,.08);overflow:hidden\">\n  <div style=\"padding:0 22px\">\n    <div data-reveal=\"\" style=\"font:500 10px/1 'DM Sans',sans-serif;letter-spacing:.24em;text-transform:uppercase;color:#5C7A46\">03 — Your day<\u002Fdiv>\n    <h2 data-reveal=\"\" data-delay=\"80\" style=\"margin:14px 0 6px;font:400 42px/1.02 'Instrument Serif',Georgia,serif;letter-spacing:-.015em\">Four decisions.<br>That's the day.<\u002Fh2>\n    <p data-reveal=\"\" data-delay=\"140\" style=\"margin:12px 0 22px;font:300 15px/1.62 'DM Sans',sans-serif;color:rgba(30,58,43,.66)\">Same shape every time. Only the ingredients change.<\u002Fp>\n  <\u002Fdiv>\n\n  <div style=\"display:flex;gap:8px;padding:0 22px 20px;overflow-x:auto;scrollbar-width:none\">\n    <sc-for list=\"{{ meals }}\" as=\"m\" hint-placeholder-count=\"4\">\n      <button sc-camel-on-click=\"{{ m.select }}\" style=\"{{ m.tabStyle }}\">{{ m.tab }}<\u002Fbutton>\n    <\u002Fsc-for>\n  <\u002Fdiv>\n\n  <div style=\"padding:0 22px\">\n    <div style=\"border-radius:22px;overflow:hidden;background:#EFEBE2;box-shadow:0 20px 50px -34px rgba(30,58,43,.7)\">\n      <div style=\"position:relative;height:210px;overflow:hidden\">\n        <div data-px=\"-14\" style=\"{{ meal.imgStyle }}\"><\u002Fdiv>\n        <div style=\"position:absolute;inset:0;background:linear-gradient(180deg,transparent 30%,rgba(30,58,43,.82))\"><\u002Fdiv>\n        <div style=\"position:absolute;left:20px;bottom:16px;right:20px\">\n          <div style=\"font:500 10px/1 'DM Sans',sans-serif;letter-spacing:.2em;text-transform:uppercase;color:rgba(251,249,245,.7)\">{{ meal.time }}<\u002Fdiv>\n          <div style=\"margin-top:6px;font:400 32px/1 'Instrument Serif',Georgia,serif;color:#FBF9F5\">{{ meal.title }}<\u002Fdiv>\n        <\u002Fdiv>\n      <\u002Fdiv>\n      <div style=\"padding:20px\">\n        <p style=\"margin:0 0 18px;font:300 14.5px/1.65 'DM Sans',sans-serif;color:rgba(30,58,43,.75)\">{{ meal.intro }}<\u002Fp>\n        <div style=\"display:flex;flex-direction:column;gap:1px;background:rgba(30,58,43,.1);border-radius:12px;overflow:hidden\">\n          <sc-for list=\"{{ meal.rows }}\" as=\"row\" hint-placeholder-count=\"3\">\n            <div style=\"display:flex;align-items:center;gap:12px;background:#FBF9F5;padding:13px 14px\">\n              <span style=\"width:8px;height:8px;border-radius:50%;background:{{ row.c }};flex:none\"><\u002Fspan>\n              <span style=\"font:500 10.5px/1 'DM Sans',sans-serif;letter-spacing:.12em;text-transform:uppercase;color:#1E3A2B;min-width:74px\">{{ row.k }}<\u002Fspan>\n              <span style=\"flex:1;font:300 13.5px/1.45 'DM Sans',sans-serif;color:rgba(30,58,43,.68);text-align:right\">{{ row.v }}<\u002Fspan>\n            <\u002Fdiv>\n          <\u002Fsc-for>\n        <\u002Fdiv>\n        <div style=\"margin-top:16px;padding:14px 16px;border-radius:12px;background:rgba(92,122,70,.1)\">\n          <span style=\"font:500 9.5px/1 'DM Sans',sans-serif;letter-spacing:.18em;text-transform:uppercase;color:#5C7A46\">Swap it<\u002Fspan>\n          <p style=\"margin:8px 0 0;font:300 13.5px/1.6 'DM Sans',sans-serif;color:rgba(30,58,43,.72)\">{{ meal.swap }}<\u002Fp>\n        <\u002Fdiv>\n      <\u002Fdiv>\n    <\u002Fdiv>\n  <\u002Fdiv>\n<\u002Fsection>\n\n<section id=\"shop\" style=\"position:relative;padding:62px 22px 70px;overflow:hidden\">\n  <div data-px=\"26\" style=\"position:absolute;bottom:-8%;left:-24%;width:64%;aspect-ratio:1;border-radius:50%;background:radial-gradient(circle,rgba(184,137,43,.16),transparent 70%)\"><\u002Fdiv>\n  <div data-reveal=\"\" style=\"font:500 10px/1 'DM Sans',sans-serif;letter-spacing:.24em;text-transform:uppercase;color:#5C7A46\">04 — The cart<\u002Fdiv>\n  <h2 data-reveal=\"\" data-delay=\"80\" style=\"margin:14px 0 8px;font:400 42px/1.02 'Instrument Serif',Georgia,serif;letter-spacing:-.015em\">Shop the plate,<br>not the aisle.<\u002Fh2>\n  <p data-reveal=\"\" data-delay=\"140\" style=\"margin:12px 0 20px;font:300 15px/1.62 'DM Sans',sans-serif;color:rgba(30,58,43,.66)\">A week of the method fits in four categories. Tap to build your list.<\u002Fp>\n\n  <div style=\"display:flex;align-items:center;gap:12px;margin-bottom:22px;padding:14px 16px;border-radius:14px;background:#FBF9F5;border:1px solid rgba(30,58,43,.08);position:relative\">\n    <div style=\"flex:1\">\n      <div style=\"font:500 10px/1 'DM Sans',sans-serif;letter-spacing:.16em;text-transform:uppercase;color:rgba(30,58,43,.5)\">In the cart<\u002Fdiv>\n      <div style=\"margin-top:8px;height:4px;border-radius:4px;background:rgba(30,58,43,.1);overflow:hidden\">\n        <div style=\"{{ cartBar }}\"><\u002Fdiv>\n      <\u002Fdiv>\n    <\u002Fdiv>\n    <div style=\"font:400 26px/1 'Instrument Serif',Georgia,serif;color:#1E3A2B\">{{ cartCount }}<\u002Fdiv>\n  <\u002Fdiv>\n\n  <div style=\"display:flex;flex-direction:column;gap:22px;position:relative\">\n    <sc-for list=\"{{ shop }}\" as=\"cat\" hint-placeholder-count=\"4\">\n      <div data-reveal=\"\">\n        <div style=\"display:flex;align-items:center;gap:10px;margin-bottom:11px\">\n          <span style=\"width:10px;height:10px;border-radius:2px;background:{{ cat.c }}\"><\u002Fspan>\n          <span style=\"font:500 10.5px/1 'DM Sans',sans-serif;letter-spacing:.18em;text-transform:uppercase;color:#1E3A2B\">{{ cat.name }}<\u002Fspan>\n          <span style=\"flex:1;height:1px;background:rgba(30,58,43,.12)\"><\u002Fspan>\n          <span style=\"font:400 11px/1 'DM Sans',sans-serif;color:rgba(30,58,43,.4)\">{{ cat.note }}<\u002Fspan>\n        <\u002Fdiv>\n        <div style=\"display:flex;flex-wrap:wrap;gap:7px\">\n          <sc-for list=\"{{ cat.items }}\" as=\"it\" hint-placeholder-count=\"6\">\n            <button sc-camel-on-click=\"{{ it.toggle }}\" style=\"{{ it.style }}\">{{ it.label }}<\u002Fbutton>\n          <\u002Fsc-for>\n        <\u002Fdiv>\n      <\u002Fdiv>\n    <\u002Fsc-for>\n  <\u002Fdiv>\n<\u002Fsection>\n\n<section id=\"prep\" style=\"position:relative;padding:62px 22px 76px;background:#1E3A2B;color:#F2EFE7;overflow:hidden\">\n  <div data-px=\"24\" style=\"position:absolute;top:-90px;left:-80px;width:260px;height:260px;border-radius:50%;border:1px solid rgba(242,239,231,.12)\"><\u002Fdiv>\n  <div data-reveal=\"\" style=\"font:500 10px/1 'DM Sans',sans-serif;letter-spacing:.24em;text-transform:uppercase;color:#9CB587\">05 — Sunday<\u002Fdiv>\n  <h2 data-reveal=\"\" data-delay=\"80\" style=\"margin:14px 0 8px;font:400 42px/1.02 'Instrument Serif',Georgia,serif;letter-spacing:-.015em\">Ninety minutes<br>buys the week.<\u002Fh2>\n  <p data-reveal=\"\" data-delay=\"140\" style=\"margin:12px 0 30px;font:300 15px/1.62 'DM Sans',sans-serif;color:rgba(242,239,231,.65);max-width:350px\">You are not cooking meals. You are stocking components, so every plate is an assembly job.<\u002Fp>\n\n  <div style=\"position:relative;padding-left:30px\">\n    <div data-px=\"-8\" style=\"position:absolute;left:8px;top:6px;bottom:30px;width:1px;background:linear-gradient(180deg,#9CB587,rgba(156,181,135,.15))\"><\u002Fdiv>\n    <sc-for list=\"{{ prep }}\" as=\"s\" hint-placeholder-count=\"4\">\n      <div data-reveal=\"\" style=\"position:relative;padding-bottom:26px\">\n        <span style=\"position:absolute;left:-30px;top:3px;width:17px;height:17px;border-radius:50%;background:#1E3A2B;border:1px solid #9CB587;display:flex;align-items:center;justify-content:center;font:500 8.5px/1 'DM Sans',sans-serif;color:#9CB587\">{{ s.n }}<\u002Fspan>\n        <div style=\"display:flex;align-items:baseline;gap:10px\">\n          <span style=\"font:400 21px/1.2 'Instrument Serif',Georgia,serif\">{{ s.title }}<\u002Fspan>\n          <span style=\"font:500 9.5px/1 'DM Sans',sans-serif;letter-spacing:.14em;text-transform:uppercase;color:#9CB587\">{{ s.min }}<\u002Fspan>\n        <\u002Fdiv>\n        <p style=\"margin:8px 0 0;font:300 14px/1.65 'DM Sans',sans-serif;color:rgba(242,239,231,.62)\">{{ s.body }}<\u002Fp>\n      <\u002Fdiv>\n    <\u002Fsc-for>\n  <\u002Fdiv>\n\n  <div data-reveal=\"\" style=\"margin-top:6px;padding:20px;border-radius:18px;background:rgba(242,239,231,.07)\">\n    <div style=\"font:500 10px/1 'DM Sans',sans-serif;letter-spacing:.18em;text-transform:uppercase;color:#9CB587\">The container rule<\u002Fdiv>\n    <p style=\"margin:10px 0 0;font:300 14px/1.65 'DM Sans',sans-serif;color:rgba(242,239,231,.72)\">Store components separately, not as finished meals. Mixed containers get boring by Wednesday and end up in the bin. Separate ones let you build a different plate every day from the same six things.<\u002Fp>\n  <\u002Fdiv>\n<\u002Fsection>\n\n<section style=\"position:relative;padding:80px 22px 120px;text-align:center;overflow:hidden\">\n  <div data-px=\"-30\" data-px-rot=\"-14\" style=\"position:absolute;top:-18%;left:50%;transform:translateX(-50%);width:88%;aspect-ratio:1;border-radius:50%;overflow:hidden;opacity:.22\">\n    <img src=\"6481ffd4-bd04-4d69-abb8-8ffef67b5ada\" alt=\"\" style=\"width:100%;height:100%;object-fit:cover;display:block;transform:scale(1.1)\">\n  <\u002Fdiv>\n  <div style=\"position:relative\">\n    <p data-reveal=\"\" style=\"margin:0 auto;max-width:330px;font:400 30px/1.22 'Instrument Serif',Georgia,serif;color:#1E3A2B\">You will not get this perfect. You do not need to.<\u002Fp>\n    <p data-reveal=\"\" data-delay=\"120\" style=\"margin:18px auto 0;max-width:310px;font:300 15px/1.65 'DM Sans',sans-serif;color:rgba(30,58,43,.66)\">Get the shape right most of the time and the results arrive quietly, without a single day of white-knuckling.<\u002Fp>\n    <a data-reveal=\"\" data-delay=\"200\" href=\"#top\" style=\"display:inline-block;margin-top:30px;padding:16px 30px;border-radius:100px;background:#1E3A2B;color:#FBF9F5;font:500 12px/1 'DM Sans',sans-serif;letter-spacing:.14em;text-transform:uppercase\">Start with one plate<\u002Fa>\n    <div style=\"margin-top:44px;font:400 11px/1.6 'DM Sans',sans-serif;color:rgba(30,58,43,.38)\">General wellness guidance, not medical advice.<br>Talk to your doctor before changing how you eat.<\u002Fdiv>\n  <\u002Fdiv>\n<\u002Fsection>\n\n<nav style=\"position:fixed;bottom:0;left:50%;transform:translateX(-50%);width:100%;max-width:520px;z-index:60;display:flex;padding:8px 10px calc(8px + env(safe-area-inset-bottom));background:rgba(251,249,245,.9);backdrop-filter:blur(14px);border-top:1px solid rgba(30,58,43,.1)\">\n  <sc-for list=\"{{ nav }}\" as=\"n\" hint-placeholder-count=\"5\">\n    <a href=\"{{ n.href }}\" style=\"{{ n.style }}\">{{ n.label }}<\u002Fa>\n  <\u002Fsc-for>\n<\u002Fnav>\n\n<\u002Fdiv>\n<\u002Fx-dc>\n<script type=\"text/x-dc\" data-dc-script=\"\" data-props=\"{&quot;$preview&quot;:{&quot;width&quot;:430,&quot;height&quot;:932}}\">\nconst HUES = { veg:'#8FAF6E', pro:'#C4794A', carb:'#D2A63F' };\n\nconst PORTIONS = [\n  { key:'veg', frac:'½', name:'Vegetables', hue:HUES.veg, short:'Volume, fiber, water — the free half',\n    body:'Half the plate goes to non-starchy vegetables. They fill the same physical space as a dense food for a fraction of the energy, so your stomach registers a full meal while the calorie total stays low. This is the single change that does the most work.',\n    examples:['Spinach','Broccoli','Peppers','Cucumber','Tomatoes','Zucchini','Cauliflower'] },\n  { key:'pro', frac:'¼', name:'Protein', hue:HUES.pro, short:'Holds muscle, blunts the craving',\n    body:'A palm-sized portion at every meal. Protein keeps you full for hours, costs more energy to digest than carbs or fat, and protects the muscle you would otherwise lose while losing weight — which is what keeps your metabolism from sagging.',\n    examples:['Chicken','Fish','Eggs','Tofu','Greek yogurt','Lean beef','Beans'] },\n  { key:'carb', frac:'¼', name:'Complex carbs', hue:HUES.carb, short:'Fuel that releases slowly',\n    body:'Carbs are not the enemy; refined ones are just poor value. High-fiber carbs release energy gradually instead of spiking and crashing you into the next snack. A cupped-hand portion is enough for most meals.',\n    examples:['Quinoa','Brown rice','Sweet potato','Oats','Farro','Lentils'] }\n];\n\nconst REASONS = [\n  { num:'01', title:'Volume beats willpower', term:'Energy density',\n    body:'You eat a fairly consistent weight of food each day, not a consistent number of calories. Fill half the plate with vegetables and the same satisfying volume arrives with far less energy attached. No portion policing required.',\n    def:'Calories per gram of food. Low-density foods let you eat more, and feel it, for less.' },\n  { num:'02', title:'Protein is the appetite lever', term:'Satiety',\n    body:'Protein triggers the fullness hormones that carbohydrate and fat barely touch. Front-load it at breakfast and the afternoon raid on the pantry mostly stops happening on its own.',\n    def:'How long a meal keeps you from wanting the next one.' },\n  { num:'03', title:'Steady blood sugar, steady day', term:'Glycemic response',\n    body:'Fiber, protein and fat slow the release of sugar into your blood. Slower release means no spike, no crash, and no 3pm hunger that feels like an emergency.',\n    def:'How fast a meal raises blood glucose — flatter is calmer.' },\n  { num:'04', title:'A shape you can repeat', term:'Adherence',\n    body:'Every diet works while you follow it. The plate survives restaurants, travel, family dinners and bad weeks because it is a proportion, not a list of forbidden foods. Repeatable beats optimal.',\n    def:'The only variable that reliably predicts long-term results.' }\n];\n\nconst MEALS = [\n  { tab:'Breakfast', time:'Within an hour of waking', title:'Breakfast', img:'img/meal-breakfast.png',\n    intro:'Set the day up so hunger never gets ahead of you. Protein first, fiber alongside, fat to hold it together.',\n    rows:[{k:'Half',v:'Fruit, oats or whole grain',c:HUES.veg},{k:'Quarter',v:'Eggs, Greek yogurt, cottage cheese',c:'#3A5470'},{k:'Quarter',v:'Avocado, nuts, seeds, nut butter',c:HUES.veg},{k:'Drink',v:'Water first, then coffee',c:'#3A5470'}],\n    swap:'Short on time? Greek yogurt, berries, a spoon of nut butter and oats in one bowl covers all three in ninety seconds.' },\n  { tab:'Lunch', time:'Four to five hours later', title:'Lunch', img:'img/meal-lunch.png',\n    intro:'The meal most likely to be eaten in a hurry, so make it the most assembled. Cold components from Sunday do the whole job.',\n    rows:[{k:'Half',v:'Leafy greens plus two raw vegetables',c:HUES.veg},{k:'Quarter',v:'Roast chicken, tuna, chickpeas, tofu',c:HUES.pro},{k:'Quarter',v:'Quinoa, farro or a sweet potato',c:HUES.carb},{k:'Finish',v:'Olive oil, lemon, salt, pepper',c:'#3A5470'}],\n    swap:'Eating out? Order the protein and a side of vegetables, treat the bread basket as the carb quarter, and stop there.' },\n  { tab:'Dinner', time:'Three hours before bed', title:'Dinner', img:'img/meal-dinner.png',\n    intro:'The classic plate, cooked hot. Keep the proportions identical to lunch — the day should not have a hard meal and an easy one.',\n    rows:[{k:'Half',v:'Roasted or steamed vegetables',c:HUES.veg},{k:'Quarter',v:'Fish, lean beef, chicken thigh, lentils',c:HUES.pro},{k:'Quarter',v:'Brown rice, potato, whole grain pasta',c:HUES.carb},{k:'Finish',v:'Herbs, acid, a little good fat',c:'#3A5470'}],\n    swap:'Late night? Drop the carb quarter and double the vegetables. Keep the protein — it is what carries you to morning.' },\n  { tab:'Snack', time:'Only if genuinely hungry', title:'The snack', img:'img/meal-snack.png',\n    intro:'A snack is a small plate, not a separate category. Two of the three components, always including protein.',\n    rows:[{k:'Protein',v:'Yogurt, cottage cheese, hard-boiled egg',c:HUES.pro},{k:'Plus',v:'Fruit, raw vegetables or a small handful of nuts',c:HUES.veg},{k:'Skip',v:'Anything eaten standing at the counter',c:'#A8552C'}],\n    swap:'Test it first: drink a full glass of water and wait ten minutes. Real hunger stays. Habit hunger leaves.' }\n];\n\nconst SHOP = [\n  { name:'The half', c:HUES.veg, note:'buy the most', items:['Spinach','Mixed greens','Broccoli','Bell peppers','Cucumber','Cherry tomatoes','Zucchini','Green beans','Frozen vegetables','Onions','Garlic'] },\n  { name:'The quarter — protein', c:HUES.pro, note:'one per meal', items:['Chicken breast','Salmon','Eggs','Greek yogurt','Cottage cheese','Firm tofu','Canned tuna','Black beans','Lean ground beef'] },\n  { name:'The quarter — carbs', c:HUES.carb, note:'buy dry', items:['Quinoa','Brown rice','Rolled oats','Sweet potatoes','Whole grain bread','Lentils','Farro'] },\n  { name:'The finish', c:'#3A5470', note:'flavor, not filler', items:['Olive oil','Lemons','Avocado','Almonds','Chia seeds','Balsamic','Fresh herbs','Spices'] }\n];\n\nconst PREP = [\n  { n:'1', title:'Roast two trays', min:'40 min', body:'One tray of vegetables, one of a starch. Same oven, same temperature. That is the half and one quarter of every plate for four days, done in one pass.' },\n  { n:'2', title:'Cook the protein twice', min:'25 min', body:'Bake a tray of chicken or fish and boil a dozen eggs. Two proteins beats one — variety is what stops week-three drift.' },\n  { n:'3', title:'Wash and cut the raw half', min:'15 min', body:'Greens washed and dried, cucumbers and peppers sliced, everything in clear containers at eye level. Visible food gets eaten.' },\n  { n:'4', title:'Portion the finish', min:'10 min', body:'Small jars of dressing, a bag of nuts split into handfuls. The step everyone skips, and the one that decides whether Thursday goes well.' }\n];\n\nconst NAV = [ {label:'Plate',href:'#method'}, {label:'Why',href:'#why'}, {label:'Day',href:'#day'}, {label:'Shop',href:'#shop'}, {label:'Prep',href:'#prep'} ];\n\nclass Component extends DCLogic {\n  state = { portion:'veg', reason:0, meal:0, checked:{}, section:'#method' };\n\n  componentDidMount() {\n    const px = () => {\n      const vh = window.innerHeight;\n      document.querySelectorAll('[data-px]').forEach(el => {\n        const r = el.getBoundingClientRect();\n        const c = (r.top + r.height / 2 - vh / 2) / vh;\n        const sp = parseFloat(el.dataset.px) || 0;\n        const rot = parseFloat(el.dataset.pxRot) || 0;\n        const base = el.dataset.pxBase || '';\n        el.style.transform = base + ' translate3d(0,' + (-c * sp).toFixed(2) + 'px,0)' + (rot ? ' rotate(' + (c * rot).toFixed(2) + 'deg)' : '');\n        el.style.willChange = 'transform';\n      });\n      this._raf = null;\n    };\n    document.querySelectorAll('[data-px]').forEach(el => {\n      if (el.dataset.pxBase === undefined) el.dataset.pxBase = el.style.transform || '';\n    });\n    this._onScroll = () => { if (!this._raf) this._raf = requestAnimationFrame(px); };\n    window.addEventListener('scroll', this._onScroll, { passive: true });\n    window.addEventListener('resize', this._onScroll);\n    px();\n\n    const io = new IntersectionObserver(es => es.forEach(e => {\n      if (!e.isIntersecting) return;\n      const d = parseInt(e.target.dataset.delay || '0', 10);\n      setTimeout(() => { e.target.style.opacity = '1'; e.target.style.transform = 'none'; }, d);\n      io.unobserve(e.target);\n    }), { threshold: 0.12, rootMargin: '0px 0px -8% 0px' });\n    document.querySelectorAll('[data-reveal]').forEach(el => {\n      el.style.opacity = '0';\n      el.style.transform = 'translateY(22px)';\n      el.style.transition = 'opacity .85s cubic-bezier(.2,.7,.2,1), transform .85s cubic-bezier(.2,.7,.2,1)';\n      io.observe(el);\n    });\n    this._io = io;\n\n    const sio = new IntersectionObserver(es => es.forEach(e => {\n      if (e.isIntersecting) this.setState({ section: '#' + e.target.id });\n    }), { rootMargin: '-45% 0px -45% 0px' });\n    ['method','why','day','shop','prep'].forEach(id => { const el = document.getElementById(id); if (el) sio.observe(el); });\n    this._sio = sio;\n  }\n\n  componentWillUnmount() {\n    window.removeEventListener('scroll', this._onScroll);\n    window.removeEventListener('resize', this._onScroll);\n    if (this._io) this._io.disconnect();\n    if (this._sio) this._sio.disconnect();\n  }\n\n  renderVals() {\n    const s = this.state;\n    const portions = PORTIONS.map(p => {\n      const open = s.portion === p.key;\n      return { ...p,\n        select: () => this.setState({ portion: open ? null : p.key }),\n        cardStyle: 'width:100%;text-align:left;border:1px solid ' + (open ? 'rgba(242,239,231,.3)' : 'rgba(242,239,231,.14)') + ';background:' + (open ? 'rgba(242,239,231,.08)' : 'transparent') + ';color:#F2EFE7;border-radius:18px;padding:16px 18px;cursor:pointer;font-family:inherit;transition:background .4s ease,border-color .4s ease',\n        chev: 'font:300 20px/1 sans-serif;color:rgba(242,239,231,.5);transition:transform .45s cubic-bezier(.2,.7,.2,1);transform:rotate(' + (open ? '135deg' : '0deg') + ')',\n        bodyStyle: 'overflow:hidden;transition:max-height .55s cubic-bezier(.2,.7,.2,1),opacity .4s ease;max-height:' + (open ? '340px' : '0px') + ';opacity:' + (open ? 1 : 0)\n      };\n    });\n\n    const reasons = REASONS.map((r, i) => {\n      const open = s.reason === i;\n      return { ...r,\n        toggle: () => this.setState({ reason: open ? -1 : i }),\n        style: 'width:100%;border:1px solid ' + (open ? 'rgba(30,58,43,.2)' : 'rgba(30,58,43,.1)') + ';background:' + (open ? '#FBF9F5' : 'rgba(251,249,245,.5)') + ';border-radius:18px;padding:18px;cursor:pointer;font-family:inherit;transition:background .4s ease,border-color .4s ease',\n        mark: 'font:300 15px/1 sans-serif;color:#5C7A46;transition:transform .45s cubic-bezier(.2,.7,.2,1);transform:rotate(' + (open ? '180deg' : '0deg') + ')',\n        bodyStyle: 'overflow:hidden;transition:max-height .55s cubic-bezier(.2,.7,.2,1),opacity .4s ease;max-height:' + (open ? '400px' : '0px') + ';opacity:' + (open ? 1 : 0)\n      };\n    });\n\n    const meals = MEALS.map((m, i) => {\n      const on = s.meal === i;\n      return { tab: m.tab, select: () => this.setState({ meal: i }),\n        tabStyle: 'flex:none;padding:11px 18px;border-radius:100px;cursor:pointer;font:500 11px/1 \"DM Sans\",sans-serif;letter-spacing:.13em;text-transform:uppercase;font-family:inherit;transition:all .35s ease;border:1px solid ' + (on ? '#1E3A2B' : 'rgba(30,58,43,.16)') + ';background:' + (on ? '#1E3A2B' : 'transparent') + ';color:' + (on ? '#FBF9F5' : 'rgba(30,58,43,.6)') };\n    });\n\n    let total = 0, count = 0;\n    const shop = SHOP.map((cat, ci) => ({ name: cat.name, c: cat.c, note: cat.note,\n      items: cat.items.map((label, ii) => {\n        const id = ci + '-' + ii; const on = !!s.checked[id]; total++; if (on) count++;\n        return { label, toggle: () => this.setState(st => ({ checked: { ...st.checked, [id]: !st.checked[id] } })),\n          style: 'padding:9px 14px;border-radius:100px;cursor:pointer;font:400 13px/1 \"DM Sans\",sans-serif;font-family:inherit;transition:all .28s ease;border:1px solid ' + (on ? cat.c : 'rgba(30,58,43,.14)') + ';background:' + (on ? cat.c : 'transparent') + ';color:' + (on ? '#FBF9F5' : 'rgba(30,58,43,.72)') };\n      }) }));\n\n    const nav = NAV.map(n => ({ ...n,\n      style: 'flex:1;text-align:center;padding:10px 0;border-radius:12px;font:500 9.5px/1 \"DM Sans\",sans-serif;letter-spacing:.12em;text-transform:uppercase;transition:all .3s ease;color:' + (s.section === n.href ? '#FBF9F5' : 'rgba(30,58,43,.5)') + ';background:' + (s.section === n.href ? '#1E3A2B' : 'transparent') }));\n\n    const R = React.createElement;\n    const wedge = (from, to, color, on) => R('div', { key: from, style: { position: 'absolute', inset: 0, background: 'conic-gradient(from ' + from + 'deg, ' + color + ' 0deg, ' + color + ' ' + (to - from) + 'deg, transparent ' + (to - from) + 'deg)', opacity: on ? 0.38 : 0, transition: 'opacity .5s ease', mixBlendMode: 'multiply' } });\n\n    return {\n      portions, reasons, meals, shop, nav,\n      prep: PREP,\n      meal: { ...MEALS[s.meal], imgStyle: 'position:absolute;top:-14%;left:0;width:100%;height:128%;background:url(' + (((window.__resources)||{})[MEALS[s.meal].img.replace(/[^a-z]/gi,'')] || MEALS[s.meal].img) + ') center/cover' },\n      pillars: [ {n:'½',t:'Vegetables'}, {n:'¼',t:'Protein'}, {n:'¼',t:'Carbs'}, {n:'3',t:'Meals a day'} ],\n      cartCount: count,\n      cartBar: 'height:100%;border-radius:4px;background:#5C7A46;transition:width .5s cubic-bezier(.2,.7,.2,1);width:' + Math.round((count / total) * 100) + '%',\n      plateOverlay: R(React.Fragment, null,\n        wedge(180, 360, '#4E7A2E', s.portion === 'veg'),\n        wedge(0, 90, '#B4592A', s.portion === 'pro'),\n        wedge(90, 180, '#C79A2E', s.portion === 'carb'))\n    };\n  }\n}\n<\u002Fscript>\n\n\n<\u002Fbody><\u002Fhtml>"
